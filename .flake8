[flake8]
max-line-length = 90
extend-ignore =
    # E203: whitespace before ':'
    E203,
    # W503: line break before binary operator
    W503
exclude =
    .git,
    __pycache__,
    .pytest_cache,
    *.egg-info,
    build,
    dist,
    .venv,
    raster_thumbnail.egg-info
per-file-ignores =
    # Ignore unused imports in __init__ files
    __init__.py:F401
